# Skopiuj do .env i uzupełnij (.env jest w .gitignore).
# scripts/env2secrets.py (wołany przez scripts/deploy.sh) generuje z niego secrets.yaml.

WIFI_SSID=
WIFI_PASSWORD=
# Hasło zapasowego hotspotu "Voice-Assistant Fallback Hotspot" (min. 8 znaków)
FALLBACK_AP_PASSWORD=

# Klucz szyfrowania API Home Assistant (32 bajty w base64).
# Wpisz TEN SAM klucz, który ma obecny firmware - inaczej HA straci połączenie z urządzeniem.
# Nowy: .venv/Scripts/python.exe -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
API_KEY=

# Hasło OTA - musi być TAKIE SAMO jak w obecnym firmware, inaczej wgrywanie przez WiFi się nie uda.
OTA_PASSWORD=

# --- Opcjonalnie: dostęp do Home Assistant (diagnostyka pipeline'u Assist) ---
# Adres HA, np. http://192.168.1.10:8123
HA_URL=
# Profil -> Bezpieczeństwo -> Tokeny dostępu o długim terminie ważności
HA_TOKEN=
